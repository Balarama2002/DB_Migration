  <bns:encryptedValues/>
  <bns:description>Fetches and validates credentials dynamically to return a list of folders. | built with boomi-companion vunknown</bns:description>
  <bns:object>
    <process allowSimultaneous="false" enableUserLog="false" processLogOnErrorOnly="false" purgeDataImmediately="false" stopProcessingIfZeroDocuments="true" updateRunDates="false" workload="general">
      <shapes>
        <!-- shape1: Start -->
        <shape image="start" name="shape1" shapetype="start" userlabel="" x="48.0" y="100.0">
          <configuration>
            <passthroughaction/>
          </configuration>
          <dragpoints>
            <dragpoint name="shape1.dragpoint1" toShape="shape2" x="224.0" y="110.0"/>
          </dragpoints>
        </shape>

        <!-- shape2: Prepare Dynamic Credentials (Data Process Groovy) -->
        <shape image="dataprocess_icon" name="shape2" shapetype="dataprocess" userlabel="Prepare Credentials &amp; URL Paths" x="273.0" y="100.0">
          <configuration>
            <dataprocess>
              <step index="1" key="1" name="Custom Scripting" processtype="12">
                <dataprocessscript language="groovy2" useCache="true">
                  <script><![CDATA[import java.util.Properties;
import java.io.InputStream;
import groovy.json.JsonSlurper;

for (int i = 0; i < dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i);
    Properties props = dataContext.getProperties(i);

    String jsonText = is.getText("UTF-8");
    def parser = new JsonSlurper();
    def credentials = parser.parseText(jsonText);

    String username = credentials.username;
    String apiToken = credentials.apiToken;
    String accountId = credentials.accountId;

    String authUser = username;
    if (!username.startsWith("BOOMI_TOKEN.")) {
        authUser = "BOOMI_TOKEN." + username;
    }
    String authString = authUser + ":" + apiToken;
    String base64Auth = authString.getBytes("UTF-8").encodeBase64().toString();

    props.setProperty("documentproperty.dynamicdocument.DDP_USERNAME", username);
    props.setProperty("documentproperty.dynamicdocument.DDP_API_TOKEN", apiToken);
    props.setProperty("documentproperty.dynamicdocument.DDP_ACCOUNT_ID", accountId);
    props.setProperty("documentproperty.dynamicdocument.DDP_AUTH_HEADER", "Basic " + base64Auth);
    props.setProperty("documentproperty.dynamicdocument.DDP_PATH_VALIDATE", "api/rest/v1/" + accountId + "/Account/" + accountId);
    props.setProperty("documentproperty.dynamicdocument.DDP_PATH_QUERY", "api/rest/v1/" + accountId + "/Folder/query");

    dataContext.storeStream(new ByteArrayInputStream(jsonText.getBytes("UTF-8")), props);
}]]></script>
                </dataprocessscript>
              </step>
            </dataprocess>
          </configuration>
          <dragpoints>
            <dragpoint name="shape2.dragpoint1" toShape="shape3" x="448.0" y="110.0"/>
          </dragpoints>
        </shape>

        <!-- shape3: Try/Catch -->
        <shape image="catcherrors_icon" name="shape3" shapetype="catcherrors" userlabel="Catch Unexpected Errors" x="498.0" y="100.0">
          <configuration>
            <catcherrors catchAll="true" retryCount="0"/>
          </configuration>
          <dragpoints>
            <dragpoint identifier="default" name="shape3.dragpoint1" text="Try" toShape="shape4" x="673.0" y="110.0"/>
            <dragpoint identifier="error" name="shape3.dragpoint2" text="Catch" toShape="shape10" x="623.0" y="510.0"/>
          </dragpoints>
        </shape>

        <!-- shape4: Clear Document Content (Message) -->
        <shape image="message_icon" name="shape4" shapetype="message" userlabel="Clear Payload for GET" x="723.0" y="100.0">
          <configuration>
            <message combined="false">
              <msgTxt></msgTxt>
              <msgParameters/>
            </message>
          </configuration>
          <dragpoints>
            <dragpoint name="shape4.dragpoint1" toShape="shape5" x="898.0" y="110.0"/>
          </dragpoints>
        </shape>

        <!-- shape5: Validate Credentials (REST Connector Shape) -->
        <shape image="connectoraction_icon" name="shape5" shapetype="connectoraction" userlabel="REST: Validate Credentials" x="948.0" y="100.0">
          <configuration>
            <connectoraction actionType="GET" allowDynamicCredentials="NONE" connectionId="d3adf534-4306-49e9-806d-e2b3dceb26c5" connectorType="officialboomi-X3979C-rest-prod" hideSettings="false" operationId="f89aa7ef-7619-4760-89b5-409d3df15809">
              <parameters/>
              <dynamicProperties>
                <propertyvalue childKey="" key="path" name="Path" valueType="track">
                  <trackparameter defaultValue="" propertyId="dynamicdocument.DDP_PATH_VALIDATE" propertyName="Dynamic Document Property - DDP_PATH_VALIDATE"/>
                </propertyvalue>
                <propertyvalue childKey="Authorization" key="requestHeaders" name="Request Headers" valueType="track">
                  <trackparameter defaultValue="" propertyId="dynamicdocument.DDP_AUTH_HEADER" propertyName="Dynamic Document Property - DDP_AUTH_HEADER"/>
                </propertyvalue>
              </dynamicProperties>
            </connectoraction>
          </configuration>
          <dragpoints>
            <dragpoint name="shape5.dragpoint1" toShape="shape6" x="1123.0" y="110.0"/>
          </dragpoints>
        </shape>

        <!-- shape6: Validate Response (Data Process Groovy) -->
        <shape image="dataprocess_icon" name="shape6" shapetype="dataprocess" userlabel="Validate Response Code/Payload" x="1173.0" y="100.0">
          <configuration>
            <dataprocess>
              <step index="1" key="1" name="Custom Scripting" processtype="12">
                <dataprocessscript language="groovy2" useCache="true">
                  <script><![CDATA[import java.util.Properties;
import java.io.InputStream;
import groovy.json.JsonSlurper;

for (int i = 0; i < dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i);
    Properties props = dataContext.getProperties(i);

    String responseText = is.getText("UTF-8");
    boolean isValid = false;
    try {
        def parser = new JsonSlurper();
        def res = parser.parseText(responseText);
        if (res.accountId != null || res.name != null) {
            isValid = true;
        }
    } catch (Exception e) {
        if (responseText.contains("<Account") && !responseText.contains("<error")) {
            isValid = true;
        }
    }

    if (isValid) {
        props.setProperty("documentproperty.dynamicdocument.DDP_VALID", "true");
    } else {
        props.setProperty("documentproperty.dynamicdocument.DDP_VALID", "false");
        props.setProperty("documentproperty.dynamicdocument.DDP_ERROR_MSG", responseText);
    }

    dataContext.storeStream(new ByteArrayInputStream(responseText.getBytes("UTF-8")), props);
}]]></script>
                </dataprocessscript>
              </step>
            </dataprocess>
          </configuration>
          <dragpoints>
            <dragpoint name="shape6.dragpoint1" toShape="shape7" x="1348.0" y="110.0"/>
          </dragpoints>
        </shape>

        <!-- shape7: Decision -->
        <shape image="decision_icon" name="shape7" shapetype="decision" userlabel="Credentials Valid?" x="1398.0" y="100.0">
          <configuration>
            <decision comparison="equals" name="Credentials Valid?">
              <decisionvalue valueType="track">
