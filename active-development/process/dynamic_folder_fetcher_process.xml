        </shape>

        <!-- shape12: HTTP POST Query Folders (REST Connector Shape) -->
        <shape image="connectoraction_icon" name="shape12" shapetype="connectoraction" userlabel="REST: Query Folders" x="1848.0" y="70.0">
          <configuration>
            <connectoraction actionType="POST" allowDynamicCredentials="NONE" connectionId="d3adf534-4306-49e9-806d-e2b3dceb26c5" connectorType="officialboomi-X3979C-rest-prod" hideSettings="false" operationId="656845d6-2982-4b23-a066-5f725c114b44">
              <parameters/>
              <dynamicProperties>
                <propertyvalue childKey="" key="path" name="Path" valueType="track">
