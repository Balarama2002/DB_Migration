                </propertyvalue>
                <propertyvalue childKey="Authorization" key="requestHeaders" name="Request Headers" valueType="track">
                  <trackparameter defaultValue="" propertyId="dynamicdocument.DDP_AUTH_HEADER" propertyName="Dynamic Document Property - DDP_AUTH_HEADER"/>
                </propertyvalue>
              </dynamicProperties>
            </connectoraction>
          </configuration>
          <dragpoints>
            <dragpoint name="shape12.dragpoint1" toShape="shape13" x="2023.0" y="80.0"/>
          </dragpoints>
        </shape>

        <!-- shape13: Format Response (Data Process Groovy) -->
        <shape image="dataprocess_icon" name="shape13" shapetype="dataprocess" userlabel="Format Folder Response JSON" x="2073.0" y="70.0">
          <configuration>
            <dataprocess>
              <step index="1" key="1" name="Custom Scripting" processtype="12">
                <dataprocessscript language="groovy2" useCache="true">
                  <script><![CDATA[import java.util.Properties;
import java.io.InputStream;
import groovy.json.JsonSlurper;
import groovy.json.JsonBuilder;

for (int i = 0; i < dataContext.getDataCount(); i++) {
    InputStream is = dataContext.getStream(i);
    Properties props = dataContext.getProperties(i);

    String responseText = is.getText("UTF-8");
    def out = [:];
    try {
        def parser = new JsonSlurper();
        def res = parser.parseText(responseText);
        if (res.results != null) {
            out.success = true;
            out.folders = res.results;
        } else if (res.error != null) {
            out.success = false;
            out.error = res.error.message ?: responseText;
        } else {
            out.success = false;
            out.error = responseText;
        }
    } catch (Exception e) {
        out.success = false;
        out.error = "Failed to parse folder response: " + e.message + " (Raw: " + responseText + ")";
    }

    String jsonOut = new JsonBuilder(out).toPrettyString();
    dataContext.storeStream(new ByteArrayInputStream(jsonOut.getBytes("UTF-8")), props);
}]]></script>
                </dataprocessscript>
              </step>
            </dataprocess>
          </configuration>
          <dragpoints>
            <dragpoint name="shape13.dragpoint1" toShape="shape14" x="2248.0" y="80.0"/>
          </dragpoints>
        </shape>

        <!-- shape14: Return Documents -->
        <shape image="returndocuments_icon" name="shape14" shapetype="returndocuments" userlabel="Return Folder List" x="2298.0" y="70.0">
          <configuration>
            <returndocuments label="Return Folder List"/>
          </configuration>
          <dragpoints/>
        </shape>

