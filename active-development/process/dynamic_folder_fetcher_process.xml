            <dragpoint identifier="false" name="shape7.dragpoint2" text="False" toShape="shape11" x="1548.0" y="310.0"/>
          </dragpoints>
        </shape>

        <!-- shape8: Prepare Folder Query (Message) -->
        <shape image="message_icon" name="shape8" shapetype="message" userlabel="Build Folder Query Body" x="1623.0" y="70.0">
          <configuration>
            <message combined="false">
              <msgTxt>'{"QueryFilter": {}}'</msgTxt>
              <msgParameters/>
            </message>
          </configuration>
